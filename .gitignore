node_modules/
.obsidian/
*.log
.DS_Store
Thumbs.db
STRIP-REPORT.md
*.tmp
frames/

# Python bytecode caches. Several daemons and tests shell out to python3, which
# writes these next to whatever source it imports.
__pycache__/
*.pyc

# The write-ahead prompt journal is local runtime state. Ignore both the live
# file and rotated dated sidecars.
**/runtime/utterance-journal*.jsonl
**/runtime/stop-writer/

# GateGuard's per-session first-touch markers are ephemeral local state.
**/runtime/gateguard/
**/runtime/NIGHTLY_PASS_STATE.json

# The semantic-search deny list names the operator's own confidential folders,
# so the names are themselves confidential. Only index-deny.example.json is
# tracked; the real file stays local.
**/semantic-search/index-deny.json

# aigent-os:generated-state:start
.aigent/
vault/memory/embeddings.json
vault/memory/HEAT_INDEX.json
vault/memory/HEAT_INDEX.json.tmp-*
vault/memory/.daemon-errors.log
memory/.daemon-errors.log
.claude/settings.aigent.json
# aigent-os:generated-state:end
