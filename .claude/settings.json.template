{
  "env": {
    "AIGENT_ROOT": "__AIGENT_ROOT__",
    "AIGENT_VAULT": "__AIGENT_ROOT__"
  },
  "idleCompaction": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"__AIGENT_ROOT__/daemons/statusline-ctx.sh\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/sessionstart-reinject.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/resume-verb.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/daemons/caddy.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/userpromptsubmit-journal.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/precompact-flush.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/pre-permission-interlock.mjs\" PreToolUse",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/ctx-refresh-sensor.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/model-tier-guard.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/gateguard.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/memory-budget-guard.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/pre-permission-interlock.mjs\" PostToolUse",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/hooks/suggest-compact.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Agent|TaskCreate|TaskUpdate|Skill|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/hooks/auto-capture.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|WebFetch|WebSearch|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/hooks/security-scan.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/daemons/caddy-detect-new-skill.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/pre-permission-interlock.mjs\" Stop",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/stop-capsule-writer.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/discipline-check.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/hooks/session-capture-summary.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash \"__AIGENT_ROOT__/hooks/log-token-usage.sh\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"__AIGENT_ROOT__/daemons/sessionend-flush.mjs\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
